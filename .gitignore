node_modules/
dist/
dist-ssr/
.vite/
.env
*.local
.DS_Store

# Local build output (the theme is built in the studio runtime); keep the
# vendored framework in theme-kit/ which the starter needs to build on clone.
!theme-kit/dist/

# QA artefacts: 58MB of Playwright screenshots and raw ledgers. Regenerated by
# `pnpm verify:live`; the written-up findings live in qa/*.md, which are staged
# deliberately when they matter.
qa/

# Locally packed theme-kit tarballs anywhere else are scratch. The ONE the
# theme installs lives in vendor/ (see vendor/README.md): a release candidate
# that is not on the registry yet, pinned by its checksum so a clean clone
# installs exactly the bytes that were verified. The earlier failure of
# `pnpm install --frozen-lockfile` on a clean clone came from a tarball that
# was referenced but ignored — hence the explicit un-ignore below.
*.tgz
!vendor/*.tgz

# Scratch output from the design/QA tooling. `design/` itself IS committed —
# it is the approved package the specs are generated from and checked against.
design/.thumbnail
