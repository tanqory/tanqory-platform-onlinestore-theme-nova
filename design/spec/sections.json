[
 {
  "name": "announcement-bar",
  "group": "Layout",
  "purpose": "Single-line store-wide notice; optional rotation of up to 3 messages.",
  "components": "Text, Text Link, IconButton (prev/next, dismiss)",
  "slots": "messages[] {text, link?}; background role",
  "responsive": "36px desktop / 32px mobile; one line, ellipsis on mobile; arrows hidden < 768 (swipe or auto-rotate).",
  "edge": "No messages → section hidden. Very long text → ellipsis + full text on tap (tooltip/expand). Dismiss persists per session.",
  "props": [
   {
    "name": "background",
    "control": "segmented",
    "options": "primary | surface-secondary",
    "def": "primary",
    "group": "Appearance",
    "resp": "no",
    "dep": "",
    "desc": "Bar color role; text auto-inverts"
   },
   {
    "name": "rotation",
    "control": "toggle",
    "options": "on | off",
    "def": "off",
    "group": "Content",
    "resp": "no",
    "dep": "messages > 1",
    "desc": "Auto-rotate messages every 6s, pauses on hover"
   },
   {
    "name": "showArrows",
    "control": "toggle",
    "options": "",
    "def": "on",
    "group": "Layout",
    "resp": "desktop",
    "dep": "rotation=on",
    "desc": "Prev/next controls on desktop"
   },
   {
    "name": "dismissible",
    "control": "toggle",
    "options": "",
    "def": "off",
    "group": "Advanced",
    "resp": "no",
    "dep": "",
    "desc": "Adds close button; hides for session"
   }
  ]
 },
 {
